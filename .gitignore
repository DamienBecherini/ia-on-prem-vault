.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/hotkeys.json
.DS_Store
.env
.deploy-manifest.json
build/
.cursor/*
!.cursor/rules/
!.cursor/rules/*.mdc

# Private notes — never on GitHub or the web (the engine respects this file at build time)
_private/*
!_private/README.md

# Obsidian templates — helper files, never published as docs pages
_templates/*

# Claude Code personal settings
.claude/settings.local.json

# Agent plans are working files (only the README is tracked)
.agents/plans/*
!.agents/plans/README.md

# Refresh working copies (dated snapshots are committed)
.agents/vault-maintenance/reports/*-latest.*

# AIContextCraft export config (personal tooling, kept locally)
config-concat*
