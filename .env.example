# Path to starlight-obsidian-engine (absolute or relative to this vault).
# Used by npm run publish / deploy / upload to delegate to the engine.
# Sibling example: ../starlight-obsidian-engine
ENGINE_PATH=../starlight-obsidian-engine

# --- Remote deploy (one target per vault) ---

# Protocol: ftps (FTP over TLS, port 21 — no SSH) or sftp (SSH, port 22).
# If omitted, port 21 → ftps, port 22 → sftp.
DEPLOY_PROTOCOL=ftps

# Remote host and credentials (password; SFTP also supports a private key).
DEPLOY_HOST=ftp.example.com
DEPLOY_PORT=21
DEPLOY_USER=
DEPLOY_PASSWORD=
# SFTP only — private key path (relative to vault or absolute) + optional passphrase:
DEPLOY_PRIVATE_KEY_PATH=
DEPLOY_PASSPHRASE=

# Set to true if the FTPS cert doesn't match the host (common on shared hosts like
# o2switch, where the cert is for *.o2switch.net). FileZilla silently accepts it.
# DEPLOY_FTPS_INSECURE=true

# Top-level remote entries the mirror must never upload nor delete (server-managed).
# Dotfiles (.htaccess, .well-known, .ftpquota) are always protected. Default: cgi-bin
# DEPLOY_PROTECT=cgi-bin

# Remote directory that receives the contents of dist/.
# FTPS accounts are usually chrooted to their site folder, so the login lands at the
# web root — use "/" (do NOT repeat the absolute /home/USER/site path, that nests it).
# SFTP: use a dedicated absolute directory (mirror refuses the real server root "/").
DEPLOY_REMOTE_PATH=/
